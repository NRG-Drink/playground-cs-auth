<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<ItemGroup Condition="'$(ImplicitUsings)' == 'enable'">
		<Using Include="NRG.Api" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GreenDonut.Data" Version="16.7.0" />
		<PackageReference Include="HotChocolate.AspNetCore" Version="16.7.0" />
		<PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="16.7.0" />
		<PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="16.7.0" />
		<PackageReference Include="HotChocolate.Data" Version="16.7.0" />
		<PackageReference Include="HotChocolate.Types.Analyzers" Version="16.7.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
	</ItemGroup>

	<PropertyGroup>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\Generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

</Project>
