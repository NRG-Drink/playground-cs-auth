{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Notes": "Data Source=notes.db"
  },
  "Jwt": {
    "Issuer": "NRG.Api",
    "Audience": "NRG.Api.Client",
    "SigningKey": "development-only-signing-key-change-this-32-bytes",
    "LifetimeMinutes": 0.05, // 3 seconds
    "RefreshTokenLifetimeDays": 0.00004 // 3.456 seconds
  },
  "AllowedHosts": "*"
}
